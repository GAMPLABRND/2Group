# Google Sheets 연동 (3종 모두 필수)
# 사용법: 이 파일을 .env.local 로 복사한 뒤 값을 채운다. (.env.local 은 커밋되지 않음)
# Vercel 배포 시에는 프로젝트 Settings → Environment Variables 에 같은 3종을 등록한다.

# 서비스 계정 이메일: Google Cloud 콘솔에서 생성한 서비스 계정 (JSON 키의 client_email)
# ※ 대상 Google Sheet 를 이 이메일에 "편집자"로 공유해야 한다.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# 서비스 계정 개인키: JSON 키 파일의 private_key 값을 "따옴표 포함 원문 그대로" 한 줄로.
# \n 이스케이프를 그대로 유지할 것 (코드가 \n 을 실제 줄바꿈으로 치환한다).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADAN...여기에_실제_키...\n-----END PRIVATE KEY-----\n"

# 스프레드시트 ID: 시트 URL 의 /d/ 와 /edit 사이 문자열
# 예: https://docs.google.com/spreadsheets/d/1AbCdEfG.../edit → 1AbCdEfG...
GOOGLE_SHEET_ID=your-google-sheet-id
